<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged by the MSVC linker into gruepr.exe's manifest (QMAKE_LFLAGS in gruepr.pro). Qt 6
     already scales per monitor (Per-Monitor V2), but it asks for that in code at startup, which
     the Windows App Certification Kit cannot see; declared here, Windows applies it before any
     window exists, and Qt finds it already set. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
